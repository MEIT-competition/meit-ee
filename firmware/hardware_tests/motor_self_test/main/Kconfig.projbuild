menu "MEIT motor self-test"

config MEIT_MOTOR_TEST_INTENSITY_PCT
    int "Motor test intensity (%)"
    range 1 100
    default 15

config MEIT_MOTOR_TEST_ON_MS
    int "Time each motor stays on (ms)"
    range 100 5000
    default 700

config MEIT_MOTOR_TEST_GAP_MS
    int "Off time between motors (ms)"
    range 100 5000
    default 500

endmenu
